# Trading-agent environment configuration
# Secrets live in the runtime environment (~/.hermes/.env on the host). NEVER commit.

# --- LLM (bounded AI review) via 9Router -> DeepSeek V4 Flash ---
# Set at runtime from the shared environment. Leave unset to disable LLM review
# (agents degrade to deterministic, NO_TRADE-safe behavior).
# OPENAI_API_KEY=<9router key>          # provided by ~/.hermes/.env at runtime
# OPENAI_BASE_URL=http://127.0.0.1:20128/v1   # 9Router OpenAI-compatible endpoint
# LLM_MODEL=ts/thirty/deepseek-v4-flash       # DeepSeek V4 Flash (only model used)

# --- Telegram notifications (observability only; never in the decision path) ---
# Prefer dedicated trading-bot vars; falls back to generic TELEGRAM_* vars.
# TRADING_TG_BOT_TOKEN=<bot token>
# TRADING_TG_CHAT_ID=<chat id>

# No exchange keys needed: MVP uses read-only public Binance REST.
